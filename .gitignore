# Lock file (optional — uncomment to ignore)
# .terraform.lock.hcl
# Variable files with actual secrets — NEVER commit these
terraform.tfvars
*.auto.tfvars
# Crash logs
crash.log
crash.*.log
# Plan output files (may contain sensitive values)
*.tfplan
plan.out

