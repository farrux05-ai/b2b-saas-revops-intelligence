# Terraform local state & credentials — NEVER commit these
terraform.tfstate
terraform.tfstate.backup
*.tfstate
*.tfstate.*
!*.tfstate.enc


# Terraform working directory
.terraform/
.terraform.lock.hcl

# Variable files with actual secrets
terraform.tfvars
*.auto.tfvars

# Crash log files
crash.log
crash.*.log

# Override files (local overrides only)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform plan output (may contain sensitive values)
*.tfplan
plan.out
