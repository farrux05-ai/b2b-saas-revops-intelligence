# Copy this file to secrets.toml and set real credentials.
# NEVER commit secrets.toml to git — it is listed in .gitignore.

[sources.posthog]
api_key = "phx_..."               # Personal API Key (phx_ prefix required)

[sources.hubspot]
api_key = "pat-..."               # HubSpot Private App Token

[sources.zendesk.credentials]
subdomain = "yourcompany"
email = "admin@example.com"
password = "your_api_token"       # Zendesk API Token (not account password)

[sources.stripe_analytics]
stripe_secret_key = "sk_live_..."

[sources.pg_replication.credentials]
drivername = "postgresql"
host = "your_postgres_host"
port = 5432
database = "your_db"
username = "your_replication_user"
password = "your_password"

# ── Snowflake Destination ────────────────────────────────────────────────────
# All pipelines write to Snowflake. Schema per source (raw_hubspot, raw_stripe, etc.)
[destination.snowflake.credentials]
account   = "xy12345.us-east-1"         # e.g. orgname-accountname.snowflakecomputing.com
user      = "TRANSFORMER"
password  = "your_snowflake_password"
database  = "REVOPS_INTELLIGENCE"
warehouse = "COMPUTE_WH"
role      = "TRANSFORMER"
