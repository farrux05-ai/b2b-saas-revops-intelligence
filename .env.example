# Copy this file to .env and fill in your values
# NEVER commit .env to git

# PostgreSQL Connection
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/revops_database

# DBT-specific variables
DBT_POSTGRES_USER=YOUR_USER
DBT_POSTGRES_PASSWORD=YOUR_PASSWORD
DBT_POSTGRES_HOST=localhost
DBT_POSTGRES_PORT=5432

# Individual settings (optional, used if DATABASE_URL not set)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=YOUR_USER
POSTGRES_PASSWORD=YOUR_PASSWORD
POSTGRES_DB=revops_database

# CI/CD Environments
CI_DB_HOST=your_ci_database_host
CI_DB_USER=your_ci_database_user
CI_DB_PASSWORD=your_ci_database_password

PROD_DB_HOST=your_prod_database_host
PROD_DB_USER=your_prod_database_user
PROD_DB_PASSWORD=your_prod_database_password

# Reverse ETL (HubSpot)
# Private App token required with scopes: crm.objects.companies.read, crm.objects.companies.write
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxx-xxxx-xxxx-xxxx

# ── Snowflake (Production warehouse) ────────────────────────
# Get from: Snowflake Console → Admin → Accounts
# Account format: orgname-accountname  (e.g. myorg-xy12345)
# Usage: dbt run --target snowflake
SNOWFLAKE_ACCOUNT=your_org-your_account
SNOWFLAKE_USER=your_snowflake_user
SNOWFLAKE_PASSWORD=your_snowflake_password
SNOWFLAKE_ROLE=TRANSFORMER
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=REVOPS_INTELLIGENCE

# ── Alerting ────────────────────────────────────────────────
SLACK_WEBHOOK=https://hooks.slack.com/services/xxx/yyy/zzz

# ── Terraform — Snowflake Infrastructure as Code ────────────
# Terraform reads TF_VAR_* env vars automatically.
# Split your SNOWFLAKE_ACCOUNT (e.g. "myorg-xy12345") into:
#   organization_name = "myorg"
#   account_name      = "xy12345"
#
# Usage:
#   cd terraform/environments/prod
#   cp terraform.tfvars.example terraform.tfvars   # fill in values
#   terraform init && terraform plan

# Admin user for Terraform provisioning (must have ACCOUNTADMIN)
TF_VAR_snowflake_organization_name=your_org
TF_VAR_snowflake_account_name=your_account
TF_VAR_snowflake_username=YOUR_ADMIN_USER
TF_VAR_snowflake_password=your_admin_password

# Service account passwords (created by Terraform)
TF_VAR_dbt_prod_password=strong_password_here
TF_VAR_dbt_ci_password=strong_password_here
TF_VAR_dlt_loader_password=strong_password_here
TF_VAR_lightdash_password=strong_password_here

# GitHub Actions secrets to configure (Settings → Secrets → Actions):
#   SNOWFLAKE_ORGANIZATION_NAME, SNOWFLAKE_ACCOUNT_NAME
#   SNOWFLAKE_TF_USERNAME, SNOWFLAKE_TF_PASSWORD
#   DBT_PROD_PASSWORD, DBT_CI_PASSWORD
#   DLT_LOADER_PASSWORD, LIGHTDASH_PASSWORD
